<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:OpenRCS.Controls"
             xmlns:viewModels="clr-namespace:OpenRCS.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
             x:DataType="viewModels:SimulationViewModel"
             x:Class="OpenRCS.Views.SimulationView">
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <controls:SimulationController Grid.Row="0" />
        <controls:SimulationCanvas Grid.Row="1" Scenario="{Binding Scenario}" />
    </Grid>
</UserControl>

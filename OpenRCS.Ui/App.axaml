<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenRCS.App"
             xmlns:local="using:OpenRCS"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <StyleInclude Source="avares://OpenRCS.Ui/Styles/OpenRcsTheme.axaml" />
    </Application.Styles>
</Application>
